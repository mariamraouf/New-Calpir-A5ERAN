{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "calpir.com"
        }
      ],
      "destination": "https://www.calpir.com/$1",
      "permanent": true
    },
    {
      "source": "/favicon.ico",
      "destination": "/logo-with-transparent-background.png",
      "permanent": true
    },
    {
      "source": "/services/marketing-branding",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/marketing-design",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/about",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|.*\\.(?:ico|png|svg|jpg|jpeg|gif|webp|webmanifest|xml|txt|json|js|css)$).*)",
      "destination": "/index.html"
    }
  ]
}
